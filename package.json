{
  "name": "rezerv-data-table",
  "version": "0.1.0",
  "private": true,
  "description": "Rezerv Frontend Assessment — Part 2. A from-scratch, fully typed, config-driven DataTable with an Ant-Design-shaped API.",
  "license": "MIT",
  "author": "Aung Myat Moe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aungmyatmoe11/rezerv-data-table.git"
  },
  "homepage": "https://rezerv-data-table.vercel.app",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:contracts": "tsc --noEmit -p tsconfig.contracts.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "validate:docs": "node scripts/validate-docs.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "~1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "~3.2.7"
  }
}
